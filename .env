# ============================================================
# GERNAS / simple_project — Environment Variables
# ============================================================
# Copy this file to .env and fill in values before running.
# Never commit .env to source control — add it to .gitignore.
# ============================================================


# ── Service Identity ─────────────────────────────────────────
# Name shown in traces, dashboards, and log queries.
SERVICE_NAME=simple-project

# Semantic version of the deployed code — update on each release.
SERVICE_VERSION=0.1.0

# Runtime environment: development | staging | production
# Controls log verbosity, sampling rates, and compliance key guard.
ENVIRONMENT=development

# Kubernetes pod name — set automatically in AKS via the Downward API.
# Set manually for local runs to identify which pod emitted a span.
POD_NAME=pod1-pricing-agent


# ── Telemetry Export Target ───────────────────────────────────
# Which backend to send traces and metrics to.
#   console         — prints to stdout (use for local development)
#   otel_collector  — sends to a running OTEL Collector via gRPC
#   azure_monitor   — sends directly to Azure Monitor App Insights
EXPORTER_TYPE=console


# ── OTEL Collector (used when EXPORTER_TYPE=otel_collector) ──
# gRPC endpoint of the OTEL Collector Gateway.
# Default points to a locally running Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317


# ── Azure Monitor (used when EXPORTER_TYPE=azure_monitor) ────
# Connection string from: Azure Portal → App Insights → Overview → Connection String.
# Delivered via CSI Secrets Store in production — never hardcode here.
# Leave blank when EXPORTER_TYPE is not azure_monitor.
APPLICATIONINSIGHTS_CONNECTION_STRING=


# ── Sampling ─────────────────────────────────────────────────
# Head-based SDK sampling rate (0.0–1.0).
# 1.0 = keep all traces (use in development and staging).
# In production, tail-based sampling at the OTEL Collector Gateway overrides this.
OTEL_SAMPLING_RATE=1.0


# ── Compliance Event Store ────────────────────────────────────
# Whether to emit Layer 03 compliance events on each pricing run.
# Must be true in staging and production.
ENABLE_COMPLIANCE=true

# W3C Baggage propagation — propagates mandatory tags (query.category, pod, etc.)
# to all child spans automatically. Should always be true.
ENABLE_BAGGAGE_PROPAGATION=true

# Path to the local compliance event log file (development only).
# In production this is replaced by an Azure Event Hub connection string.
COMPLIANCE_STORE=compliance_events.jsonl

# HMAC-SHA256 signing key for compliance event chain integrity.
# MUST be changed to a cryptographically random value in staging and production.
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
# In production this value comes from Azure Key Vault — never store it here.
COMPLIANCE_HMAC_KEY=dev-insecure-key-change-in-prod


# ── simple_project App Settings ──────────────────────────────
# Maximum number of retries for external API calls (RWA engine, deal DB, etc.)
MAX_RETRIES=3

# Azure OpenAI model deployment name to use for LLM reasoning.
LLM_MODEL=gpt-4o-mini

# Base URL of the internal RWA (Risk-Weighted Assets) capital calculation engine.
# Replace with the actual internal endpoint before running against a real deal.
RWA_ENGINE_URL=http://localhost:9000
